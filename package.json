{
  "name": "acdsee-classic",
  "version": "0.1.0",
  "description": "ACDSee Classic clone — cross-platform image browser for macOS, Windows and Linux",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "ACDSee Classic contributors",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "dist": "yarn build && electron-builder",
    "dist:mac": "yarn build && electron-builder --mac",
    "dist:win": "yarn build && electron-builder --win",
    "dist:linux": "yarn build && electron-builder --linux",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "exifr": "7.1.3",
    "image-size": "2.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.acdsee.classic",
    "productName": "ACDSee Classic",
    "copyright": "Copyright © 2026 ACDSee Classic contributors",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Graphics",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
